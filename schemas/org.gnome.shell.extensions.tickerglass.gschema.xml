<!--
  One schema shared by the TickerGlass app and the GNOME Shell extension.
  Both processes read/write the same dconf keys, so a watchlist edited in
  either place shows up live in the other. The extension installs the schema
  under its own schemas/ dir and install.sh also links it into the user's
  glib-2.0/schemas dir so plain apps can see it.
-->
<schemalist>
  <schema id="org.gnome.shell.extensions.tickerglass"
          path="/org/gnome/shell/extensions/tickerglass/">

    <!-- ── watchlists ───────────────────────────────────────────────────
         JSON: [{"id":"…","name":"…","symbols":["AAPL","BTC-USD", …]}, …]
         Symbol formats Yahoo understands: AAPL, BRK-B, ^GSPC (indices),
         EURUSD=X (FX), BTC-USD (crypto), ES=F (futures).          -->
    <key name="watchlists" type="s">
      <default>'[{"id":"main","name":"Watchlist","symbols":["AAPL","MSFT","NVDA","^GSPC","BTC-USD"]}]'</default>
      <summary>Watchlists</summary>
      <description>All watchlists as a JSON array of {id, name, symbols}</description>
    </key>
    <key name="active-watchlist" type="s">
      <default>'main'</default>
      <summary>Active watchlist id</summary>
    </key>

    <!-- what the hero pill shows next to the (always visible) price:
         the dollar move or the percentage move for the visible chart
         range (click the pill to flip) -->
    <key name="change-style" type="s">
      <default>'dollars'</default>
      <choices>
        <choice value='dollars'/>
        <choice value='pct'/>
      </choices>
      <summary>Change display style</summary>
      <description>'dollars' shows the absolute move, 'pct' the percentage over the visible range</description>
    </key>

    <!-- ── data ────────────────────────────────────────────────────────── -->
    <key name="data-source" type="s">
      <default>'yahoo'</default>
      <choices>
        <choice value='yahoo'/>
        <choice value='yahoo-relay'/>
        <choice value='nasdaq'/>
        <choice value='demo'/>
      </choices>
      <summary>Data source</summary>
      <description>'yahoo' hits finance.yahoo.com directly; 'yahoo-relay' routes the same requests through a public fetch proxy when your network is rate-limited; 'nasdaq' uses Nasdaq's keyless site API for US stocks/ETFs (crypto, indices and news ride the relay); 'demo' generates plausible offline data</description>
    </key>
    <key name="refresh-seconds" type="i">
      <default>60</default>
      <range min="15" max="3600"/>
      <summary>Quote refresh interval</summary>
    </key>

    <!-- ── panel presentation ──────────────────────────────────────────── -->
    <key name="panel-mode" type="s">
      <default>'sparkline'</default>
      <choices>
        <choice value='sparkline'/>
        <choice value='ticker'/>
        <choice value='price'/>
      </choices>
      <summary>Panel presentation</summary>
      <description>'sparkline' draws a live mini-chart of the lead symbol; 'ticker' scrolls symbols; 'price' shows price only</description>
    </key>
    <key name="panel-lead-symbol" type="s">
      <default>''</default>
      <summary>Lead symbol for panel</summary>
      <description>Symbol drawn in the panel; empty means the first symbol of the active watchlist</description>
    </key>
    <key name="panel-show-change" type="b">
      <default>true</default>
      <summary>Show change next to the panel price</summary>
    </key>
    <key name="panel-spark-range" type="s">
      <default>'1d'</default>
      <choices>
        <choice value='1d'/>
        <choice value='5d'/>
      </choices>
      <summary>Window the panel sparkline shows</summary>
    </key>
    <key name="menu-two-column" type="b">
      <default>true</default>
      <summary>Two-column movers menu</summary>
      <description>Top gainers and top losers side by side in the dropdown (wide card); false stacks them vertically in a narrow card</description>
    </key>

    <!-- ── chart defaults (shared: card + app) ─────────────────────────── -->
    <key name="chart-range" type="s">
      <default>'1y'</default>
      <summary>Chart range</summary>
      <description>1d 7d 1mo 52w ytd 1y 2y 5y</description>
    </key>
    <key name="chart-interval" type="s">
      <default>'auto'</default>
      <summary>Chart bar interval</summary>
      <description>'auto' picks a sensible interval for the range; or 1m 5m 15m 30m 1h 1d 1wk 1mo</description>
    </key>
    <key name="chart-style" type="s">
      <default>'area'</default>
      <choices>
        <choice value='area'/>
        <choice value='line'/>
        <choice value='candles'/>
      </choices>
      <summary>Chart style</summary>
    </key>
    <key name="compare-symbol" type="s">
      <default>''</default>
      <summary>Chart comparison overlay</summary>
      <description>Symbol overlaid on the hero chart, normalized to the
        primary's first point (e.g. QQQ). Empty means no comparison.</description>
    </key>
    <key name="spark-range" type="s">
      <default>'5d'</default>
      <choices>
        <choice value='1d'/>
        <choice value='5d'/>
        <choice value='1mo'/>
        <choice value='6mo'/>
      </choices>
      <summary>Sparkline window</summary>
      <description>Lookback for the inline sparklines in the table and
        movers tiles: 1d, 5d, 1mo or 6mo.</description>
    </key>
    <key name="movers-scope" type="s">
      <default>'list'</default>
      <choices>
        <choice value='list'/>
        <choice value='market'/>
      </choices>
      <summary>Movers page scope</summary>
      <description>'list' ranks the active watchlist, 'market' pulls
        the whole-US-market gainers/losers screener.</description>
    </key>

    <!-- ── table (app), also drives the card row fields ─────────────────
         JSON: {"visible":["symbol","price",…],"sort":"symbol","asc":true}
         Known columns: symbol name price change pct day-range week52
                       volume exchange currency updated                     -->
    <key name="columns" type="s">
      <default>'{"visible":["symbol","name","price","change","pct","day-range","volume"],"sort":"symbol","asc":true}'</default>
      <summary>Visible table columns and sorting</summary>
    </key>

    <!-- ── runtime state / app UI ──────────────────────────────────────── -->
    <key name="selected-symbol" type="s">
      <default>''</default>
      <summary>Symbol shown in the big chart (card hero / app focus)</summary>
    </key>
    <key name="app-theme" type="s">
      <default>'default'</default>
      <choices>
        <choice value='default'/>
        <choice value='light'/>
        <choice value='dark'/>
      </choices>
      <summary>Application color scheme</summary>
    </key>
    <key name="sidebar-visible" type="b">
      <default>true</default>
      <summary>Watchlist sidebar visibility (app)</summary>
    </key>
    <key name="sidebar-width" type="i">
      <default>280</default>
      <range min="180" max="480"/>
      <summary>Sidebar width in pixels (drag the divider; 180-480)</summary>
    </key>
  </schema>
</schemalist>
